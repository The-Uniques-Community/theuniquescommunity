{
  "rewrites": [
    {
      "source": "/api/image-proxy/:path*",
      "destination": "https://the-uniques-portal.vercel.app/api/image-proxy/:path*"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://the-uniques-portal.vercel.app/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
