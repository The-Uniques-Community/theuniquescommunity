{
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/image-proxy/:path*",
      "destination": "https://the-uniques-portal.vercel.app/api/image-proxy/:path*"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://the-uniques-portal.vercel.app/api/$1"
    },
    {
      "source": "/auth/(.*)",
      "destination": "https://the-uniques-portal.vercel.app/auth/$1"
    },
    {
      "source": "/upload/(.*)",
      "destination": "https://the-uniques-portal.vercel.app/upload/$1"
    },
    {
      "source": "/((?!assets/|.*\\.[a-zA-Z0-9]+$).*)",
      "destination": "/index.html"
    }
  ]
}
